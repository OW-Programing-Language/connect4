# The Connect 4 grid: 6 rows x 7 columns, stored as a flat array.
class Board:
  field cells
  field rows
  field cols

  fn new():
    set this.rows: 6
    set this.cols: 7
    set this.cells: array(42, 0)

  fn idx(r, c):
    return: r * this.cols + c

  fn get(r, c):
    return: this.cells[this.idx(r, c)]

  fn put(r, c, v):
    set cells: this.cells
    set cells[this.idx(r, c)]: v

  fn in_bounds(r, c):
    if: r < 0
      return: 0
    if: r >= this.rows
      return: 0
    if: c < 0
      return: 0
    if: c >= this.cols
      return: 0
    return: 1

  # Drop a piece into a column; returns the row it landed on, or 0-1 if full.
  fn drop(col, player):
    set r: this.rows - 1
    while: r >= 0
      if: this.get(r, col) == 0
        call: this.put(r, col, player)
        return: r
      set r: r - 1
    return: 0 - 1

  fn line(r, c, dr, dc):
    set v: this.get(r, c)
    if: v == 0
      return: 0
    set k: 1
    while: k < 4
      set rr: r + dr * k
      set cc: c + dc * k
      if: this.in_bounds(rr, cc) == 0
        return: 0
      if: this.get(rr, cc) != v
        return: 0
      set k: k + 1
    return: v

  fn winner():
    set r: 0
    while: r < this.rows
      set c: 0
      while: c < this.cols
        set w: this.line(r, c, 0, 1)
        if: w != 0
          return: w
        set w: this.line(r, c, 1, 0)
        if: w != 0
          return: w
        set w: this.line(r, c, 1, 1)
        if: w != 0
          return: w
        set w: this.line(r, c, 1, 0 - 1)
        if: w != 0
          return: w
        set c: c + 1
      set r: r + 1
    return: 0
